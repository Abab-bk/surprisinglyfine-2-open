msgid "每成功闪避一次攻击，下一次攻击必定暴击。"
msgstr ""
"Bir saldırıyı başarıyla savuşturduğunda, bir sonraki saldırı kesinlikle "
"kritik vuruş yapar."

msgid "百折不挠的真诚"
msgstr "Yılmaz Dürüstlük"

msgid "攻击时有 3% 的概率触发两次伤害。"
msgstr "Saldırıda %3 olasılıkla iki kez hasar verilir."

msgid "直言不讳的勇敢"
msgstr "Açık Sözlü Cesaret"

msgid "每场战斗随机激活 1 个效果：+50% 伤害 / +30% 防御 / 双倍经验"
msgstr ""
"Her savaşta rastgele 1 etki aktif olur: +%50 hasar / +%30 savunma / çift "
"deneyim"

msgid "空想家"
msgstr "Hayalperest"

msgid "击杀一名敌人后，掉落稀有物品的概率 +1%，可叠加，但是生命值低于 50% 时失效。"
msgstr ""
"Bir düşmanı öldürdükten sonra, nadir eşya düşme olasılığı %1 artar, "
"yığılabilir ancak can %50'nin altına düştüğünde etkisizleşir."

msgid "令人震惊的"
msgstr "Şaşırtıcı"

msgid "生命低于 20% 时，自动触发“再生”，每秒回复 5% 生命（持续 10 秒，CD 2 分钟）。"
msgstr ""
"Can %20'nin altına düştüğünde, otomatik olarak 'yenilenme' tetiklenir, "
"saniyede %5 can yenilenir (10 saniye sürer, 2 dakika bekleme süresi)."

msgid "恐慌的"
msgstr "Panik"

msgid "命中时，5% 几率使敌人无法行动 5 秒。不可重复触发。"
msgstr ""
"İsabet ettiğinde, %5 olasılıkla düşman 5 saniye boyunca eylem yapamaz. Tekrar "
"tetiklenemez."

msgid "无法忍受的"
msgstr "Katlanılmaz"

msgid "承受切割伤害时，10% 几率反弹 50% 伤害给攻击者。"
msgstr ""
"Kesme hasarı aldığında, %10 olasılıkla hasarın %50'sini saldırgana geri "
"yansıtır."

msgid "邪恶的"
msgstr "Kötü"

msgid "钓鱼速度提升 15%，但 10% 概率什么也不获得。"
msgstr ""
"Balıkçılık hızı %15 artar, ancak %10 olasılıkla hiçbir şey elde edilmez."

msgid "难以置信的"
msgstr "İnanılmaz"

msgid "砍树时，5% 的概率获得 1 木炭。"
msgstr "Ağaç keserken, %5 olasılıkla 1 kömür elde edilir."

msgid "搞点货"
msgstr "Biraz Mal Getir"

msgid "获得的战斗经验降低 30%，但将这部分的 50% 均分给所有非战斗技能。"
msgstr ""
"Elde edilen savaş deneyimi %30 azalır, ancak bu kısmın %50'si tüm savaş dışı "
"becerilere eşit olarak dağıtılır."

msgid "空间管理"
msgstr "Alan Yönetimi"

msgid "背包格子每空出一格，获得 0.2% 的全局伤害加成；每占用一格，获得 0.2% 的全局减伤。"
msgstr ""
"Sırt çantası yuvası boşaldıkça, küresel hasar artışı %0.2 elde edilir; her "
"dolu yuva için, küresel hasar azaltma %0.2 elde edilir."

msgid "麻烦的"
msgstr "Sorunlu"

msgid "战斗奖励不会再掉落金币，会选择其他掉落物作为替代。"
msgstr ""
"Savaş ödülleri artık altın düşürmeyecek, bunun yerine diğer düşürme eşyaları "
"seçilecek."

msgid "一心二用的"
msgstr "Çoklu Görev"

msgid "佩戴并战斗时，考古的速度提升 10%。"
msgstr "Takılıyken ve savaşırken, arkeoloji hızı %10 artar."

msgid "底子很好的"
msgstr "Temeli Çok İyi"

msgid "攻击间隔每有 2s，最终伤害 +10%。"
msgstr "Saldırı aralığı her 2 saniyede, nihai hasar +%10."

msgid "主角般的"
msgstr "Ana Karakter Gibi"

msgid "敌人对你的命中率提升 20%，但作为回报，敌人掉落稀有物品的概率提升 1.5 倍。"
msgstr ""
"Düşmanların sana isabet oranı %20 artar, ancak karşılığında düşmanların nadir "
"eşya düşürme olasılığı 1.5 kat artar."

msgid "形容词的"
msgstr "Sıfat"

msgid "你的命中率降低 20%，但你的所有技能的产出倍率增加 10%。"
msgstr ""
"Senin isabet oranın %20 düşer, ancak tüm becerilerinin üretim çarpanı %10 "
"artar."

msgid "哈哈哈"
msgstr "Ha Ha Ha"

msgid "训练技能时有 10% 概率播放哈哈的笑声。"
msgstr "Becerileri eğitirken %10 olasılıkla ha ha ha kahkahası çalar."

