msgstr "釣魚速度提升 15%，但 10% 機率什麼也不獲得。"

msgid "难以置信的"
msgstr "難以置信的"

msgid "砍树时，5% 的概率获得 1 木炭。"
msgstr "砍樹時，5% 的機率獲得 1 木炭。"

msgid "搞点货"
msgstr "搞點貨"

msgid "获得的战斗经验降低 30%，但将这部分的 50% 均分给所有非战斗技能。"
msgstr "獲得的戰鬥經驗降低 30%，但將這部分的 50% 均分給所有非戰鬥技能。"

msgid "空间管理"
msgstr "空間管理"

