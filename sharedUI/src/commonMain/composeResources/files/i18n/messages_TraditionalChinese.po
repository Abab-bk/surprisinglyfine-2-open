msgid "空想家"
msgstr "空想家"

msgid "击杀一名敌人后，掉落稀有物品的概率 +1%，可叠加，但是生命值低于 50% 时失效。"
msgstr "擊殺一名敵人後，掉落稀有物品的機率 +1%，可疊加，但是生命值低於 50% 時失效。"

msgid "令人震惊的"
msgstr "令人震驚的"

msgid "生命低于 20% 时，自动触发“再生”，每秒回复 5% 生命（持续 10 秒，CD 2 分钟）。"
msgstr "生命低於 20% 時，自動觸發「再生」，每秒回復 5% 生命（持續 10 秒，CD 2 分鐘）。"

msgid "恐慌的"
msgstr "恐慌的"

msgid "命中时，5% 几率使敌人无法行动 5 秒。不可重复触发。"
msgstr "命中時，5% 幾率使敵人無法行動 5 秒。不可重複觸發。"

msgid "无法忍受的"
msgstr "無法忍受的"

