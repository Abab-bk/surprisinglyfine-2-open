msgid "伐木"
msgstr "伐木"

msgid ""
"主要产出：原木、水果\n"
"\n"
"用途：\n"
"- 原木 → 转化为炭（冶炼、烹饪所需）\n"
"- 原木 → 建造社区基础设施\n"
"- 水果 → 转化为肥料（农业所需）\n"
"\n"
"技能加成：每级 +0.25% 伐木效率（提供立即完成行动的概率）\n"
"核心工具：斧头（提高伐木速度）"
msgstr ""
"主要產出：原木、水果\n"
"\n"
"用途：\n"
"- 原木 → 轉化為炭（冶煉、烹飪所需）\n"
"- 原木 → 建造社區基礎設施\n"
"- 水果 → 轉化為肥料（農業所需）\n"
"\n"
"技能加成：每級 +0.25% 伐木效率（提供立即完成行動的機率）\n"
"核心工具：斧頭（提高伐木速度）"

msgid "采矿"
msgstr "採礦"

msgid ""
"主要产出：矿石、宝石\n"
"\n"
"用途：\n"
"- 矿石 → 冶炼成锭\n"
"- 宝石 → 冶炼成宝石精华\n"
"\n"
"技能加成：每级 +0.25% 采矿效率（提供立即完成行动的概率）\n"
"核心工具：镐子（提高采矿速度）"
