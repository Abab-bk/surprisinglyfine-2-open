msgid "每成功闪避一次攻击，下一次攻击必定暴击。"
msgstr ""
"Chaque esquive réussie garantit un coup critique sur la prochaine attaque."

msgid "百折不挠的真诚"
msgstr "Sincérité inébranlable"

msgid "攻击时有 3% 的概率触发两次伤害。"
msgstr "3% de chance d'infliger deux fois des dégâts lors d'une attaque."

msgid "直言不讳的勇敢"
msgstr "Bravoure franche"

msgid "每场战斗随机激活 1 个效果：+50% 伤害 / +30% 防御 / 双倍经验"
msgstr "Effet aléatoire en combat : +50% dégâts / +30% défense / double XP"

msgid "空想家"
msgstr "Rêveur"

msgid "击杀一名敌人后，掉落稀有物品的概率 +1%，可叠加，但是生命值低于 50% 时失效。"
msgstr ""
"Après avoir tué un ennemi, +1% de chance d'obtenir un objet rare, cumulable, "
"mais désactivé sous 50% PV."

msgid "令人震惊的"
msgstr "Choquant"

msgid "生命低于 20% 时，自动触发“再生”，每秒回复 5% 生命（持续 10 秒，CD 2 分钟）。"
msgstr ""
"Sous 20% PV, déclenche auto-régénération : 5% PV/s pendant 10s (CD 2 min)."

msgid "恐慌的"
msgstr "Paniqué"

msgid "命中时，5% 几率使敌人无法行动 5 秒。不可重复触发。"
msgstr ""
"5% de chance d'immobiliser l'ennemi pendant 5s lors d'un coup. Non cumulable."

msgid "无法忍受的"
msgstr "Insupportable"

msgid "承受切割伤害时，10% 几率反弹 50% 伤害给攻击者。"
msgstr "10% de chance de renvoyer 50% des dégâts de tranchage subis."

msgid "邪恶的"
msgstr "Maléfique"

msgid "钓鱼速度提升 15%，但 10% 概率什么也不获得。"
msgstr "Vitesse de pêche +15%, mais 10% de risque de ne rien obtenir."

msgid "难以置信的"
msgstr "Incroyable"

msgid "砍树时，5% 的概率获得 1 木炭。"
msgstr "5% de chance d'obtenir 1 charbon en coupant du bois."

msgid "搞点货"
msgstr "Approvisionnement"

msgid "获得的战斗经验降低 30%，但将这部分的 50% 均分给所有非战斗技能。"
msgstr ""
"XP de combat -30%, mais 50% de cette perte est répartie entre les compétences "
"non-combat."

msgid "空间管理"
msgstr "Gestion d'espace"

msgid "背包格子每空出一格，获得 0.2% 的全局伤害加成；每占用一格，获得 0.2% 的全局减伤。"
msgstr ""
"Chaque case vide +0,2% dégâts globaux ; chaque case occupée +0,2% réduction "
"dégâts."

msgid "麻烦的"
msgstr "Gênant"

msgid "战斗奖励不会再掉落金币，会选择其他掉落物作为替代。"
msgstr "Pas de pièces d'or en butin de combat, remplacées par d'autres objets."

msgid "一心二用的"
msgstr "Distrait"

msgid "佩戴并战斗时，考古的速度提升 10%。"
msgstr "Vitesse d'archéologie +10% en combat."

msgid "底子很好的"
msgstr "Bases solides"

msgid "攻击间隔每有 2s，最终伤害 +10%。"
msgstr "Dégâts finaux +10% par tranche de 2s d'intervalle d'attaque."

msgid "主角般的"
msgstr "Protagoniste"

msgid "敌人对你的命中率提升 20%，但作为回报，敌人掉落稀有物品的概率提升 1.5 倍。"
msgstr "Précision ennemie +20%, mais chance d'objets rares x1,5."

msgid "形容词的"
msgstr "Adjectif"

msgid "你的命中率降低 20%，但你的所有技能的产出倍率增加 10%。"
msgstr "Votre précision -20%, mais rendement de toutes les compétences +10%."

msgid "哈哈哈"
msgstr "Hahaha"

msgid "训练技能时有 10% 概率播放哈哈的笑声。"
msgstr "10% de chance de rire lors de l'entraînement."

msgid "Shift+Tab"
msgstr "Shift+Tab"

msgid "佩戴时，每次打开 Steam 覆盖层 +1 金币。"
msgstr "+1 pièce d'or à chaque ouverture de l'interface Steam."

