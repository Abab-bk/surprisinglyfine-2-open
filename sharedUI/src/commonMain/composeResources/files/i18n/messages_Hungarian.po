msgid "伐木"
msgstr "Favágás"

msgid ""
"主要产出：原木、水果\n"
"\n"
"用途：\n"
"- 原木 → 转化为炭（冶炼、烹饪所需）\n"
"- 原木 → 建造社区基础设施\n"
"- 水果 → 转化为肥料（农业所需）\n"
"\n"
"技能加成：每级 +0.25% 伐木效率（提供立即完成行动的概率）\n"
"核心工具：斧头（提高伐木速度）"
msgstr ""
"Fő termékek: tűzifa, gyümölcs\n"
"\n"
"Felhasználás:\n"
"- Tűzifa → szénné alakítás (kohászathoz, főzéshez)\n"
"- Tűzifa → közösségi infrastruktúra építéséhez\n"
"- Gyümölcs → trágyává alakítás (mezőgazdasághoz)\n"
"\n"
"Képesség bónusz: minden szint +0,25% favágási hatékonyság (azonnali cselekvés "
"esélyt biztosít)\n"
"Alap eszköz: bárd (növeli a favágás sebességét)"

msgid "采矿"
msgstr "Bányászat"

msgid ""
"主要产出：矿石、宝石\n"
"\n"
"用途：\n"
"- 矿石 → 冶炼成锭\n"
"- 宝石 → 冶炼成宝石精华\n"
"\n"
"技能加成：每级 +0.25% 采矿效率（提供立即完成行动的概率）\n"
"核心工具：镐子（提高采矿速度）"
msgstr ""
"Fő termékek: érc, drágakő\n"
"\n"
"Felhasználás:\n"
"- Érc → öntvényré alakítás\n"
"- Drágakő → drágakő kivonattá alakítás\n"
"\n"
"Képesség bónusz: minden szint +0,25% bányászati hatékonyság (azonnali "
"cselekvés esélyt biztosít)\n"
"Alap eszköz: csákány (növeli a bányászat sebességét)"

msgid "冶炼"
msgstr "Kohászat"

msgid ""
"制作内容：\n"
"- 矿石 + 炭 → 锭\n"
"- 宝石 + 炭 → 宝石精华\n"
"\n"
"用途：\n"
"- 锭和宝石精华 → 锻造武器、工具、盔甲、饰品\n"
"- 锭和宝石精华 → 建造社区基础设施\n"
"\n"
"技能加成：每级 +0.25% 冶炼效率（提供立即完成行动的概率）\n"
"核心建筑：熔炉（提高冶炼速度）"
msgstr ""
"Készítés:\n"
"- Érc + szén → öntvény\n"
"- Drágakő + szén → drágakő kivonat\n"
"\n"
"Felhasználás:\n"
"- Öntvény és drágakő kivonat → fegyverek, eszközök, páncélok, ékszerek "
"kovácsolásához\n"
"- Öntvény és drágakő kivonat → közösségi infrastruktúra "
"építéséhez\n"
"\n"
"Képesség bónusz: minden szint +0,25% kohászati hatékonyság (azonnali "
"cselekvés esélyt biztosít)\n"
"Alap épület: kemence (növeli a kohászat sebességét)"

msgid "锻造"
msgstr "Kovácsolás"

msgid ""
"制作内容：武器、工具、盔甲、饰品\n"
"所需材料：锭、宝石精华\n"
"技能加成：每级 +0.25% 锻造效率（提供立即完成行动的概率）\n"
"核心建筑：铁砧（提高锻造速度）"
msgstr ""
"Készítés: fegyverek, eszközök, páncélok, ékszerek\n"
"Szükséges anyagok: öntvény, drágakő kivonat\n"
"Képesség bónusz: minden szint +0,25% kovácsolási hatékonyság (azonnali "
"cselekvés esélyt biztosít)\n"
"Alap épület: üllő (növeli a kovácsolás sebességét)"

msgid "农业"
msgstr "Mezőgazdaság"

msgid ""
"主要产出：鲜花、蔬菜\n"
"\n"
"用途：\n"
"- 鲜花 → 炼金术制作药水\n"
"- 蔬菜 → 烹饪豪华料理（战斗治疗）\n"
"\n"
"所需材料：\n"
"- 种子（商店购买）\n"
"- 肥料（由水果转化）\n"
"\n"
"技能加成：每级 +0.25% 农业效率（提供立即完成行动的概率）\n"
"核心工具：铲子（提高农业速度）"
msgstr ""
"Fő termékek: virágok, zöldségek\n"
"\n"
"Felhasználás:\n"
"- Virágok → alkimista gyógyszerek készítéséhez\n"
"- Zöldségek → luxus ételek főzéséhez (harci gyógyítás)\n"
"\n"
"Szükséges anyagok:\n"
"- Magok (boltban vásárolhatók)\n"
"- Trágya (gyümölcsből alakítható)\n"
"\n"
"Képesség bónusz: minden szint +0,25% mezőgazdasági hatékonyság (azonnali "
"cselekvés esélyt biztosít)\n"
"Alap eszköz: lapát (növeli a mezőgazdaság sebességét)"

msgid "炼金"
msgstr "Alkímia"

msgid ""
"制作内容：各类药水\n"
"\n"
"所需材料：\n"
"- 鲜花（农业）\n"
"- 骨头（战斗）\n"
"- 瓶子（商店）\n"
"\n"
"药水效果：提供多种增益效果，默认持续 180 秒\n"
"技能加成：每级 +0.25% 炼金效率（提供立即完成行动的概率）\n"
"核心建筑：炼金实验室（提高炼金速度）"
msgstr ""
"Készítmények: Különböző bájitalok\n"
"\n"
"Szükséges anyagok:\n"
"- Virágok (mezőgazdaság)\n"
"- Csontok (harc)\n"
"- Üvegek (bolt)\n"
"\n"
"Bájital hatások: Többféle előnyt nyújt, alapértelmezésben 180 másodpercig "
"tart\n"
"Készség bónusz: Minden szint +0,25% alkímiai hatékonyság (azonnali cselekvés "
"esélyt biztosít)\n"
"Központi épület: Alkímia laboratórium (növeli az alkímia sebességét)"

msgid "钓鱼"
msgstr "Horgászat"

msgid ""
"主要产出：鱼\n"
"用途：烹饪料理（战斗治疗）\n"
"技能加成：每级 +0.25% 钓鱼效率（提供立即完成行动的概率）\n"
"核心工具：鱼竿（提高钓鱼速度）"
msgstr ""
"Fő termék: Halak\n"
"Felhasználás: Főzés (harc gyógyítás)\n"
"Készség bónusz: Minden szint +0,25% horgászati hatékonyság (azonnali "
"cselekvés esélyt biztosít)\n"
"Központi eszköz: Horgászbot (növeli a horgászat sebességét)"

msgid "烹饪"
msgstr "Főzés"

msgid ""
"制作内容：各类料理\n"
"所需材料：食材（鱼和蔬菜）+ 炭\n"
"料理效果：战斗中生命值低于 33% 时自动使用，恢复生命值（冷却时间 15 秒）\n"
"技能加成：每级 +0.25% 烹饪效率（提供立即完成行动的概率）\n"
"核心建筑：烹饪锅（提高烹饪速度）"
msgstr ""
"Készítmények: Különböző ételek\n"
"Szükséges anyagok: Alapanyagok (halak és zöldségek) + Szén\n"
"Étel hatások: Automatikusan használódik, ha a harcban az életerő 33% alá "
"esik, visszaállítja az életerőt (15 másodperces visszahűlés)\n"
"Készség bónusz: Minden szint +0,25% főzési hatékonyság (azonnali cselekvés "
"esélyt biztosít)\n"
"Központi épület: Főzőüst (növeli a főzés sebességét)"

msgid "狩猎"
msgstr "Vadászat"

msgid ""
"主要产出：皮革、墨水、羽毛\n"
"用途：制作地图（制图技能所需）\n"
"所需材料：蚯蚓（钓鱼获得）\n"
"技能加成：每级 +0.25% 狩猎效率（提供立即完成行动的概率）\n"
"核心工具：陷阱（提高狩猎速度）"
