msgid "每成功闪避一次攻击，下一次攻击必定暴击。"
msgstr "Minden sikeres kitérés után a következő támadás biztosan kritikus lesz."

msgid "百折不挠的真诚"
msgstr "Töretlen őszinteség"

msgid "攻击时有 3% 的概率触发两次伤害。"
msgstr "Támadáskor 3% esély van a sebzés kétszeresére."

msgid "直言不讳的勇敢"
msgstr "Őszinte bátorság"

msgid "每场战斗随机激活 1 个效果：+50% 伤害 / +30% 防御 / 双倍经验"
msgstr ""
"Minden harcban véletlenszerűen aktiválódik 1 hatás: +50% sebzés / +30% "
"védelem / dupla tapasztalat"

msgid "空想家"
msgstr "Álmodozó"

msgid "击杀一名敌人后，掉落稀有物品的概率 +1%，可叠加，但是生命值低于 50% 时失效。"
msgstr ""
"Egy ellenség legyőzése után a ritka tárgyak esésének esélye +1%, halmozható, "
"de az élet 50% alá csökkenésekor érvényét veszti."

msgid "令人震惊的"
msgstr "Megrázó"

msgid "生命低于 20% 时，自动触发“再生”，每秒回复 5% 生命（持续 10 秒，CD 2 分钟）。"
msgstr ""
"Az élet 20% alá csökkenésekor automatikusan aktiválódik a \"regeneráció\", "
"másodpercenként 5% élet visszatöltődik (10 másodpercig, 2 perces "
"visszatöltődési idő)."

msgid "恐慌的"
msgstr "Pánikba esett"

msgid "命中时，5% 几率使敌人无法行动 5 秒。不可重复触发。"
msgstr ""
"Találatkor 5% esély, hogy az ellenség 5 másodpercre cselekvésképtelenné "
"válik. Nem ismételhető."

msgid "无法忍受的"
msgstr "Elviselhetetlen"

msgid "承受切割伤害时，10% 几率反弹 50% 伤害给攻击者。"
msgstr ""
"Vágási sebzés elszenvedésekor 10% esély, hogy a sebzés 50%-a visszapattan a "
"támadóra."

msgid "邪恶的"
msgstr "Gonosz"

msgid "钓鱼速度提升 15%，但 10% 概率什么也不获得。"
msgstr "A horgászati sebesség 15%-kal nő, de 10% esély, hogy semmit nem kapsz."

msgid "难以置信的"
msgstr "Hihetetlen"

msgid "砍树时，5% 的概率获得 1 木炭。"
msgstr "Fák vágásakor 5% esély 1 faszénre."

msgid "搞点货"
msgstr "Szerezzen árut"

msgid "获得的战斗经验降低 30%，但将这部分的 50% 均分给所有非战斗技能。"
msgstr ""
"A harcokból kapott tapasztalat 30%-kal csökken, de ennek 50%-át megosztja az "
"összes nem harci készség között."

msgid "空间管理"
msgstr "Térmenedzsment"

msgid "背包格子每空出一格，获得 0.2% 的全局伤害加成；每占用一格，获得 0.2% 的全局减伤。"
msgstr ""
"Minden üres táskahely után 0,2% globális sebzésbónuszt kap; minden elfoglalt "
"hely után 0,2% globális védelmi bónuszt kap."

msgid "麻烦的"
msgstr "Problémás"

msgid "战斗奖励不会再掉落金币，会选择其他掉落物作为替代。"
msgstr ""
"A harci jutalmak nem fognak aranyat dobni, más tárgyakat választanak helyette."

msgid "一心二用的"
msgstr "Két dologra koncentráló"

msgid "佩戴并战斗时，考古的速度提升 10%。"
msgstr "Viselése és harc közben a régészet sebessége 10%-kal nő."

msgid "底子很好的"
msgstr "Jó alapú"

msgid "攻击间隔每有 2s，最终伤害 +10%。"
msgstr "Minden 2 másodperccel a támadási intervallumban a végső sebzés +10%."

msgid "主角般的"
msgstr "Főhősies"

msgid "敌人对你的命中率提升 20%，但作为回报，敌人掉落稀有物品的概率提升 1.5 倍。"
msgstr ""
"Az ellenség találati aránya 20%-kal nő, de cserébe az ellenség ritka "
"tárgyakat esik 1,5-szer gyakrabban."

msgid "形容词的"
msgstr "Melléknév"

msgid "你的命中率降低 20%，但你的所有技能的产出倍率增加 10%。"
msgstr ""
"A találati arányod 20%-kal csökken, de az összes készséged termelési szorzója "
"10%-kal nő."

msgid "哈哈哈"
msgstr "Hahaha"

msgid "训练技能时有 10% 概率播放哈哈的笑声。"
msgstr "Készség gyakorlásakor 10% esély van a hahahás nevetés lejátszására."

msgid "Shift+Tab"
msgstr "Shift+Tab"

msgid "佩戴时，每次打开 Steam 覆盖层 +1 金币。"
msgstr "Viselésekor, minden Steam Overlay megnyitásakor +1 arany."

