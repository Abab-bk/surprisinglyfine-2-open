msgid "伐木"
msgstr "Lenhador"

msgid ""
"主要产出：原木、水果\n"
"\n"
"用途：\n"
"- 原木 → 转化为炭（冶炼、烹饪所需）\n"
"- 原木 → 建造社区基础设施\n"
"- 水果 → 转化为肥料（农业所需）\n"
"\n"
"技能加成：每级 +0.25% 伐木效率（提供立即完成行动的概率）\n"
"核心工具：斧头（提高伐木速度）"
msgstr ""
"Produção Principal: Madeira, Frutas\n"
"\n"
"Utilização:\n"
"- Madeira → Transformada em Carvão (necessário para Fundição e Culinária)\n"
"- Madeira → Construção de Infraestrutura Comunitária\n"
"- Frutas → Transformadas em Fertilizante (necessário para "
"Agricultura)\n"
"\n"
"Bônus de Habilidade: +0.25% de eficiência de Lenhador por nível (fornece "
"probabilidade de conclusão imediata da ação)\n"
"Ferramenta Principal: Machado (aumenta a velocidade de Lenhador)"

msgid "采矿"
msgstr "Minerador"

msgid ""
"主要产出：矿石、宝石\n"
"\n"
"用途：\n"
"- 矿石 → 冶炼成锭\n"
"- 宝石 → 冶炼成宝石精华\n"
"\n"
"技能加成：每级 +0.25% 采矿效率（提供立即完成行动的概率）\n"
"核心工具：镐子（提高采矿速度）"
msgstr ""
"Produção Principal: Minérios, Gemas\n"
"\n"
"Utilização:\n"
"- Minérios → Fundidos em Lingotes\n"
"- Gemas → Fundidas em Essência de Gema\n"
"\n"
"Bônus de Habilidade: +0.25% de eficiência de Minerador por nível (fornece "
"probabilidade de conclusão imediata da ação)\n"
"Ferramenta Principal: Picareta (aumenta a velocidade de Minerador)"

msgid "冶炼"
msgstr "Fundição"

msgid ""
"制作内容：\n"
"- 矿石 + 炭 → 锭\n"
"- 宝石 + 炭 → 宝石精华\n"
"\n"
"用途：\n"
"- 锭和宝石精华 → 锻造武器、工具、盔甲、饰品\n"
"- 锭和宝石精华 → 建造社区基础设施\n"
"\n"
"技能加成：每级 +0.25% 冶炼效率（提供立即完成行动的概率）\n"
"核心建筑：熔炉（提高冶炼速度）"
msgstr ""
"Conteúdo de Produção:\n"
"- Minérios + Carvão → Lingotes\n"
"- Gemas + Carvão → Essência de Gema\n"
"\n"
"Utilização:\n"
"- Lingotes e Essência de Gema → Forjamento de Armas, Ferramentas, Armaduras, "
"Acessórios\n"
"- Lingotes e Essência de Gema → Construção de Infraestrutura "
"Comunitária\n"
"\n"
"Bônus de Habilidade: +0.25% de eficiência de Fundição por nível (fornece "
"probabilidade de conclusão imediata da ação)\n"
"Edifício Principal: Forno (aumenta a velocidade de Fundição)"

msgid "锻造"
msgstr "Forjador"

msgid ""
"制作内容：武器、工具、盔甲、饰品\n"
"所需材料：锭、宝石精华\n"
"技能加成：每级 +0.25% 锻造效率（提供立即完成行动的概率）\n"
"核心建筑：铁砧（提高锻造速度）"
msgstr ""
"Conteúdo de Produção: Armas, Ferramentas, Armaduras, Acessórios\n"
"Materiais Necessários: Lingotes, Essência de Gema\n"
"Bônus de Habilidade: +0.25% de eficiência de Forjador por nível (fornece "
"probabilidade de conclusão imediata da ação)\n"
"Edifício Principal: Bigorna (aumenta a velocidade de Forjador)"

msgid "农业"
msgstr "Agricultor"

msgid ""
"主要产出：鲜花、蔬菜\n"
"\n"
"用途：\n"
"- 鲜花 → 炼金术制作药水\n"
"- 蔬菜 → 烹饪豪华料理（战斗治疗）\n"
"\n"
"所需材料：\n"
"- 种子（商店购买）\n"
"- 肥料（由水果转化）\n"
"\n"
"技能加成：每级 +0.25% 农业效率（提供立即完成行动的概率）\n"
"核心工具：铲子（提高农业速度）"
msgstr ""
"Produção Principal: Flores, Vegetais\n"
"\n"
"Utilização:\n"
"- Flores → Alquimia para criar poções\n"
"- Vegetais → Culinária para criar pratos luxuosos (cura de "
"batalha)\n"
"\n"
"Materiais Necessários:\n"
"- Sementes (compradas na loja)\n"
"- Fertilizante (transformado de frutas)\n"
"\n"
"Bônus de Habilidade: +0.25% de eficiência de Agricultor por nível (fornece "
"probabilidade de conclusão imediata da ação)\n"
"Ferramenta Principal: Pá (aumenta a velocidade de Agricultor)"

msgid "炼金"
msgstr "Alquimia"

msgid ""
"制作内容：各类药水\n"
"\n"
"所需材料：\n"
"- 鲜花（农业）\n"
"- 骨头（战斗）\n"
"- 瓶子（商店）\n"
"\n"
"药水效果：提供多种增益效果，默认持续 180 秒\n"
"技能加成：每级 +0.25% 炼金效率（提供立即完成行动的概率）\n"
"核心建筑：炼金实验室（提高炼金速度）"
msgstr ""
"Produção: Vários tipos de poções\n"
"\n"
"Materiais necessários:\n"
"- Flores (Agricultura)\n"
"- Ossos (Combate)\n"
"- Garrafas (Loja)\n"
"\n"
"Efeitos da poção: Fornece vários efeitos de buff, com duração padrão de 180 "
"segundos\n"
"Bônus de habilidade: +0.25% de eficiência de alquimia por nível (aumenta a "
"probabilidade de conclusão imediata da ação)\n"
"Edifício principal: Laboratório de Alquimia (aumenta a velocidade da alquimia)"

msgid "钓鱼"
msgstr "Pesca"

msgid ""
"主要产出：鱼\n"
"用途：烹饪料理（战斗治疗）\n"
"技能加成：每级 +0.25% 钓鱼效率（提供立即完成行动的概率）\n"
"核心工具：鱼竿（提高钓鱼速度）"
msgstr ""
"Produção principal: Peixes\n"
"Uso: Cozinhar (cura em combate)\n"
"Bônus de habilidade: +0.25% de eficiência de pesca por nível (aumenta a "
"probabilidade de conclusão imediata da ação)\n"
"Ferramenta principal: Vara de pesca (aumenta a velocidade da pesca)"

msgid "烹饪"
msgstr "Culinária"

msgid ""
"制作内容：各类料理\n"
"所需材料：食材（鱼和蔬菜）+ 炭\n"
"料理效果：战斗中生命值低于 33% 时自动使用，恢复生命值（冷却时间 15 秒）\n"
"技能加成：每级 +0.25% 烹饪效率（提供立即完成行动的概率）\n"
"核心建筑：烹饪锅（提高烹饪速度）"
msgstr ""
"Produção: Vários tipos de pratos\n"
"Materiais necessários: Ingredientes (peixes e vegetais) + Carvão\n"
"Efeitos do prato: Usado automaticamente quando a vida está abaixo de 33% em "
"combate, restaura vida (tempo de recarga de 15 segundos)\n"
"Bônus de habilidade: +0.25% de eficiência de culinária por nível (aumenta a "
"probabilidade de conclusão imediata da ação)\n"
"Edifício principal: Panela de Cozinha (aumenta a velocidade da culinária)"

msgid "狩猎"
msgstr "Caça"

msgid ""
"主要产出：皮革、墨水、羽毛\n"
"用途：制作地图（制图技能所需）\n"
"所需材料：蚯蚓（钓鱼获得）\n"
"技能加成：每级 +0.25% 狩猎效率（提供立即完成行动的概率）\n"
"核心工具：陷阱（提高狩猎速度）"
msgstr ""
"Produção principal: Couro, Tinta, Penas\n"
"Uso: Criar mapas (necessário para a habilidade de Cartografia)\n"
"Materiais necessários: Minhocas (obtidas na pesca)\n"
"Bônus de habilidade: +0.25% de eficiência de caça por nível (aumenta a "
"probabilidade de conclusão imediata da ação)\n"
"Ferramenta principal: Armadilha (aumenta a velocidade da caça)"

msgid "制图"
msgstr "Cartografia"

msgid ""
"制作内容：地图\n"
"所需材料：皮革、墨水、羽毛\n"
"\n"
"用途：\n"
"- 考古技能消耗品\n"
"- 挑战精英怪物所需\n"
"\n"
"技能加成：每级 +0.25% 制图效率（提供立即完成行动的概率）\n"
"核心建筑：制图台（提高制图速度）"
msgstr ""
"Produção: Mapas\n"
"Materiais necessários: Couro, Tinta, Penas\n"
"\n"
"Uso:\n"
"- Consumível para a habilidade de Arqueologia\n"
"- Necessário para desafiar monstros de elite\n"
"\n"
"Bônus de habilidade: +0.25% de eficiência de cartografia por nível (aumenta a "
"probabilidade de conclusão imediata da ação)\n"
"Edifício principal: Mesa de Cartografia (aumenta a velocidade da cartografia)"

msgid "考古"
msgstr "Arqueologia"

msgid ""
"特殊机制：被动技能，可与其他技能同时进行\n"
"所需材料：地图\n"
"主要产出：神器\n"
"\n"
"神器系统：\n"
"- 建造祭坛后可激活神器\n"
"- 最多同时激活 3 个神器\n"
"- 激活需要消耗资源\n"
"\n"
"加速方式：使用星星加速考古进度"
msgstr ""
"Mecânica especial: Habilidade passiva, pode ser realizada simultaneamente com "
"outras habilidades\n"
"Materiais necessários: Mapas\n"
"Produção principal: Artefatos\n"
"\n"
"Sistema de artefatos:\n"
"- Construir \"Altar\" para ativar artefatos\n"
"- Ativar até 3 artefatos simultaneamente\n"
"- Ativação requer consumo de recursos\n"
"\n"
"Método de aceleração: Use estrelas para acelerar o progresso da arqueologia"

msgid "单手武器"
msgstr "Armas de Uma Mão"

msgid ""
"武器类型：剑、锤子\n"
"技能加成：每级 +0.25% 单手效率（训练时有机会双倍战斗经验和战利品）\n"
"\n"
"命中率机制：\n"
"基础命中率：75%（等级匹配时）\n"
"每高于怪物 1 级：+0.5% 命中率（上限 90%）\n"
"每低于怪物 1 级：-0.5% 命中率"
msgstr ""
"Tipos de arma: Espada, Martelo\n"
"Bônus de habilidade: +0.25% de eficiência de uma mão por nível (treinamento "
"tem chance de duplicar experiência de combate e saque)\n"
"\n"
"Mecanismo de taxa de acerto:\n"
"Taxa de acerto base: 75% (quando o nível coincide)\n"
"A cada 1 nível acima do monstro: +0.5% de taxa de acerto (limite 90%)\n"
"A cada 1 nível abaixo do monstro: -0.5% de taxa de acerto"

msgid "双手武器"
msgstr "Armas de Duas Mãos"

msgid ""
"武器类型：长矛、镰刀\n"
"技能加成：每级 +0.25% 双手效率（训练时有机会双倍战斗经验和战利品）\n"
"\n"
"命中率机制：\n"
"基础命中率：75%（等级匹配时）\n"
"每高于怪物 1 级：+0.5% 命中率（上限 90%）\n"
"每低于怪物 1 级：-0.5% 命中率"
msgstr ""
"Tipos de arma: Lança, Foice\n"
"Bônus de habilidade: +0.25% de eficiência de duas mãos por nível (treinamento "
"tem chance de duplicar experiência de combate e saque)\n"
"\n"
"Mecanismo de taxa de acerto:\n"
"Taxa de acerto base: 75% (quando o nível coincide)\n"
"A cada 1 nível acima do monstro: +0.5% de taxa de acerto (limite 90%)\n"
"A cada 1 nível abaixo do monstro: -0.5% de taxa de acerto"

msgid "远程武器"
msgstr "Armas de Longo Alcance"

msgid ""
"武器类型：弓、回旋镖\n"
"技能加成：每级 +0.25% 远程效率（训练时有机会双倍战斗经验和战利品）\n"
"\n"
"命中率机制：\n"
"基础命中率：75%（等级匹配时）\n"
"每高于怪物 1 级：+0.5% 命中率（上限 90%）\n"
"每低于怪物 1 级：-0.5% 命中率"
msgstr ""
"Tipos de arma: Arco, Bumerangue\n"
"Bônus de habilidade: +0.25% de eficiência de longo alcance por nível "
"(treinamento tem chance de duplicar experiência de combate e "
"saque)\n"
"\n"
"Mecanismo de taxa de acerto:\n"
"Taxa de acerto base: 75% (quando o nível coincide)\n"
"A cada 1 nível acima do monstro: +0.5% de taxa de acerto (limite 90%)\n"
"A cada 1 nível abaixo do monstro: -0.5% de taxa de acerto"

msgid "防御"
msgstr "Defesa"

msgid ""
"技能加成：每级 +0.25% 防御效率（训练时有机会双倍战斗经验和战利品）\n"
"\n"
"防御机制：降低怪物命中率\n"
"每高于怪物 1 级：怪物命中率 -0.5%\n"
"每低于怪物 1 级：怪物命中率 +0.5%"
msgstr ""
"Bônus de habilidade: +0.25% de eficiência de defesa por nível (treinamento "
"tem chance de duplicar experiência de combate e saque)\n"
"\n"
"Mecanismo de defesa: Reduz a taxa de acerto do monstro\n"
"A cada 1 nível acima do monstro: Taxa de acerto do monstro -0.5%\n"
"A cada 1 nível abaixo do monstro: Taxa de acerto do monstro +0.5%"

