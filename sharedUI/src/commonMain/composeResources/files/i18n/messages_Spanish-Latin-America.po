msgid "伐木"
msgstr "Tala de árboles"

msgid ""
"主要产出：原木、水果\n"
"\n"
"用途：\n"
"- 原木 → 转化为炭（冶炼、烹饪所需）\n"
"- 原木 → 建造社区基础设施\n"
"- 水果 → 转化为肥料（农业所需）\n"
"\n"
"技能加成：每级 +0.25% 伐木效率（提供立即完成行动的概率）\n"
"核心工具：斧头（提高伐木速度）"
msgstr ""
"Producción principal: madera, frutas\n"
"\n"
"Usos:\n"
"- Madera → convertida en carbón (necesario para fundición y cocina)\n"
"- Madera → construcción de infraestructura comunitaria\n"
"- Frutas → convertidas en fertilizante (necesario para agricultura)\n"
"\n"
"Mejora de habilidad: +0.25% de eficiencia de tala por nivel (proporciona "
"probabilidad de completar acción inmediatamente)\n"
"Herramienta principal: hacha (aumenta la velocidad de tala)"

msgid "采矿"
msgstr "Minería"

msgid ""
"主要产出：矿石、宝石\n"
"\n"
"用途：\n"
"- 矿石 → 冶炼成锭\n"
"- 宝石 → 冶炼成宝石精华\n"
"\n"
"技能加成：每级 +0.25% 采矿效率（提供立即完成行动的概率）\n"
"核心工具：镐子（提高采矿速度）"
msgstr ""
"Producción principal: minerales, gemas\n"
"\n"
"Usos:\n"
"- Minerales → fundidos en lingotes\n"
"- Gemas → fundidas en esencia de gema\n"
"\n"
"Mejora de habilidad: +0.25% de eficiencia de minería por nivel (proporciona "
"probabilidad de completar acción inmediatamente)\n"
"Herramienta principal: pico (aumenta la velocidad de minería)"

msgid "冶炼"
msgstr "Fundición"

msgid ""
"制作内容：\n"
"- 矿石 + 炭 → 锭\n"
"- 宝石 + 炭 → 宝石精华\n"
"\n"
"用途：\n"
"- 锭和宝石精华 → 锻造武器、工具、盔甲、饰品\n"
"- 锭和宝石精华 → 建造社区基础设施\n"
"\n"
"技能加成：每级 +0.25% 冶炼效率（提供立即完成行动的概率）\n"
"核心建筑：熔炉（提高冶炼速度）"
msgstr ""
"Contenido de producción:\n"
"- Minerales + Carbón → Lingotes\n"
"- Gemas + Carbón → Esencia de gema\n"
"\n"
"Usos:\n"
"- Lingotes y esencia de gema → forja de armas, herramientas, armaduras, "
"accesorios\n"
"- Lingotes y esencia de gema → construcción de infraestructura "
"comunitaria\n"
"\n"
"Mejora de habilidad: +0.25% de eficiencia de fundición por nivel (proporciona "
"probabilidad de completar acción inmediatamente)\n"
"Edificio principal: horno (aumenta la velocidad de fundición)"

msgid "锻造"
msgstr "Forja"

msgid ""
"制作内容：武器、工具、盔甲、饰品\n"
"所需材料：锭、宝石精华\n"
"技能加成：每级 +0.25% 锻造效率（提供立即完成行动的概率）\n"
"核心建筑：铁砧（提高锻造速度）"
msgstr ""
"Contenido de producción: armas, herramientas, armaduras, "
"accesorios\n"
"Materiales requeridos: lingotes, esencia de gema\n"
"Mejora de habilidad: +0.25% de eficiencia de forja por nivel (proporciona "
"probabilidad de completar acción inmediatamente)\n"
"Edificio principal: yunque (aumenta la velocidad de forja)"

msgid "农业"
msgstr "Agricultura"

msgid ""
"主要产出：鲜花、蔬菜\n"
"\n"
"用途：\n"
"- 鲜花 → 炼金术制作药水\n"
"- 蔬菜 → 烹饪豪华料理（战斗治疗）\n"
"\n"
"所需材料：\n"
"- 种子（商店购买）\n"
"- 肥料（由水果转化）\n"
"\n"
"技能加成：每级 +0.25% 农业效率（提供立即完成行动的概率）\n"
"核心工具：铲子（提高农业速度）"
msgstr ""
"Producción principal: flores, vegetales\n"
"\n"
"Usos:\n"
"- Flores → alquimia para crear pociones\n"
"- Vegetales → cocina de platos de lujo (curación en combate)\n"
"\n"
"Materiales requeridos:\n"
"- Semillas (compra en tienda)\n"
"- Fertilizante (convertido de frutas)\n"
"\n"
"Mejora de habilidad: +0.25% de eficiencia de agricultura por nivel "
"(proporciona probabilidad de completar acción inmediatamente)\n"
"Herramienta principal: pala (aumenta la velocidad de agricultura)"

msgid "炼金"
msgstr "Alquimia"

msgid ""
"制作内容：各类药水\n"
"\n"
"所需材料：\n"
"- 鲜花（农业）\n"
"- 骨头（战斗）\n"
"- 瓶子（商店）\n"
"\n"
"药水效果：提供多种增益效果，默认持续 180 秒\n"
"技能加成：每级 +0.25% 炼金效率（提供立即完成行动的概率）\n"
"核心建筑：炼金实验室（提高炼金速度）"
msgstr ""
"Contenido de creación: Varias pociones\n"
"\n"
"Materiales requeridos:\n"
"- Flores (Agricultura)\n"
"- Huesos (Combate)\n"
"- Botellas (Tienda)\n"
"\n"
"Efectos de pociones: Proporcionan múltiples efectos de mejora, duración por "
"defecto de 180 segundos\n"
"Bonificación de habilidad: +0.25% de eficiencia de alquimia por nivel "
"(proporciona probabilidad de completar acción inmediatamente)\n"
"Edificio central: Laboratorio de alquimia (aumenta la velocidad de alquimia)"

msgid "钓鱼"
msgstr "Pesca"

msgid ""
"主要产出：鱼\n"
"用途：烹饪料理（战斗治疗）\n"
"技能加成：每级 +0.25% 钓鱼效率（提供立即完成行动的概率）\n"
"核心工具：鱼竿（提高钓鱼速度）"
msgstr ""
"Producción principal: Pescado\n"
"Uso: Cocina (curación en combate)\n"
"Bonificación de habilidad: +0.25% de eficiencia de pesca por nivel "
"(proporciona probabilidad de completar acción inmediatamente)\n"
"Herramienta central: Caña de pescar (aumenta la velocidad de pesca)"

msgid "烹饪"
msgstr "Cocina"

msgid ""
"制作内容：各类料理\n"
"所需材料：食材（鱼和蔬菜）+ 炭\n"
"料理效果：战斗中生命值低于 33% 时自动使用，恢复生命值（冷却时间 15 秒）\n"
"技能加成：每级 +0.25% 烹饪效率（提供立即完成行动的概率）\n"
"核心建筑：烹饪锅（提高烹饪速度）"
msgstr ""
"Contenido de creación: Varias comidas\n"
"Materiales requeridos: Ingredientes (pescado y verduras) + Carbón\n"
"Efectos de comida: Se usa automáticamente cuando la vida en combate está por "
"debajo del 33%, restaura vida (tiempo de recarga de 15 "
"segundos)\n"
"Bonificación de habilidad: +0.25% de eficiencia de cocina por nivel "
"(proporciona probabilidad de completar acción inmediatamente)\n"
"Edificio central: Olla de cocina (aumenta la velocidad de cocina)"

msgid "狩猎"
msgstr "Caza"

msgid ""
"主要产出：皮革、墨水、羽毛\n"
"用途：制作地图（制图技能所需）\n"
"所需材料：蚯蚓（钓鱼获得）\n"
"技能加成：每级 +0.25% 狩猎效率（提供立即完成行动的概率）\n"
"核心工具：陷阱（提高狩猎速度）"
msgstr ""
"Producción principal: Piel, Tinta, Plumas\n"
"Uso: Crear mapas (requiere habilidad de cartografía)\n"
"Materiales requeridos: Lombrices (obtenidas por pesca)\n"
"Bonificación de habilidad: +0.25% de eficiencia de caza por nivel "
"(proporciona probabilidad de completar acción inmediatamente)\n"
"Herramienta central: Trampa (aumenta la velocidad de caza)"

msgid "制图"
msgstr "Cartografía"

msgid ""
"制作内容：地图\n"
"所需材料：皮革、墨水、羽毛\n"
"\n"
"用途：\n"
"- 考古技能消耗品\n"
"- 挑战精英怪物所需\n"
"\n"
"技能加成：每级 +0.25% 制图效率（提供立即完成行动的概率）\n"
"核心建筑：制图台（提高制图速度）"
msgstr ""
"Contenido de creación: Mapas\n"
"Materiales requeridos: Piel, Tinta, Plumas\n"
"\n"
"Uso:\n"
"- Consumible para la habilidad de arqueología\n"
"- Requerido para desafiar monstruos de élite\n"
"\n"
"Bonificación de habilidad: +0.25% de eficiencia de cartografía por nivel "
"(proporciona probabilidad de completar acción inmediatamente)\n"
"Edificio central: Mesa de cartografía (aumenta la velocidad de cartografía)"

msgid "考古"
msgstr "Arqueología"

msgid ""
"特殊机制：被动技能，可与其他技能同时进行\n"
"所需材料：地图\n"
"主要产出：神器\n"
"\n"
"神器系统：\n"
"- 建造祭坛后可激活神器\n"
"- 最多同时激活 3 个神器\n"
"- 激活需要消耗资源\n"
"\n"
"加速方式：使用星星加速考古进度"
msgstr ""
"Mecánica especial: Habilidad pasiva, puede realizarse simultáneamente con "
"otras habilidades\n"
"Materiales requeridos: Mapas\n"
"Producción principal: Artefactos\n"
"\n"
"Sistema de artefactos:\n"
"- Construye un \"Altar\" para activar artefactos\n"
"- Máximo de 3 artefactos activos simultáneamente\n"
"- La activación consume recursos\n"
"\n"
"Método de aceleración: Usa estrellas para acelerar el progreso de la "
"arqueología"

msgid "单手武器"
msgstr "Armas de una mano"

msgid ""
"武器类型：剑、锤子\n"
"技能加成：每级 +0.25% 单手效率（训练时有机会双倍战斗经验和战利品）\n"
"\n"
"命中率机制：\n"
"基础命中率：75%（等级匹配时）\n"
"每高于怪物 1 级：+0.5% 命中率（上限 90%）\n"
"每低于怪物 1 级：-0.5% 命中率"
msgstr ""
"Tipo de arma: Espada, Martillo\n"
"Bonificación de habilidad: +0.25% de eficiencia de una mano por nivel "
"(durante el entrenamiento hay oportunidad de doble experiencia de combate y "
"botín)\n"
"\n"
"Mecánica de tasa de acierto:\n"
"Tasa de acierto base: 75% (cuando el nivel coincide)\n"
"Por cada nivel superior al monstruo: +0.5% de tasa de acierto (límite "
"90%)\n"
"Por cada nivel inferior al monstruo: -0.5% de tasa de acierto"

msgid "双手武器"
msgstr "Armas de dos manos"

msgid ""
"武器类型：长矛、镰刀\n"
"技能加成：每级 +0.25% 双手效率（训练时有机会双倍战斗经验和战利品）\n"
"\n"
"命中率机制：\n"
"基础命中率：75%（等级匹配时）\n"
"每高于怪物 1 级：+0.5% 命中率（上限 90%）\n"
"每低于怪物 1 级：-0.5% 命中率"
msgstr ""
"Tipo de arma: Lanza, Hoz\n"
"Bonificación de habilidad: +0.25% de eficiencia de dos manos por nivel "
"(durante el entrenamiento hay oportunidad de doble experiencia de combate y "
"botín)\n"
"\n"
"Mecánica de tasa de acierto:\n"
"Tasa de acierto base: 75% (cuando el nivel coincide)\n"
"Por cada nivel superior al monstruo: +0.5% de tasa de acierto (límite "
"90%)\n"
"Por cada nivel inferior al monstruo: -0.5% de tasa de acierto"

msgid "远程武器"
msgstr "Armas a distancia"

msgid ""
"武器类型：弓、回旋镖\n"
"技能加成：每级 +0.25% 远程效率（训练时有机会双倍战斗经验和战利品）\n"
"\n"
"命中率机制：\n"
"基础命中率：75%（等级匹配时）\n"
"每高于怪物 1 级：+0.5% 命中率（上限 90%）\n"
"每低于怪物 1 级：-0.5% 命中率"
msgstr ""
"Tipo de arma: Arco, Búmeran\n"
"Bonificación de habilidad: +0.25% de eficiencia a distancia por nivel "
"(durante el entrenamiento hay oportunidad de doble experiencia de combate y "
"botín)\n"
"\n"
"Mecánica de tasa de acierto:\n"
"Tasa de acierto base: 75% (cuando el nivel coincide)\n"
"Por cada nivel superior al monstruo: +0.5% de tasa de acierto (límite "
"90%)\n"
"Por cada nivel inferior al monstruo: -0.5% de tasa de acierto"

msgid "防御"
msgstr "Defensa"

msgid ""
"技能加成：每级 +0.25% 防御效率（训练时有机会双倍战斗经验和战利品）\n"
"\n"
"防御机制：降低怪物命中率\n"
"每高于怪物 1 级：怪物命中率 -0.5%\n"
"每低于怪物 1 级：怪物命中率 +0.5%"
msgstr ""
"Bonificación de habilidad: +0.25% de eficiencia de defensa por nivel (durante "
"el entrenamiento hay oportunidad de doble experiencia de combate y "
"botín)\n"
"\n"
"Mecánica de defensa: Reduce la tasa de acierto del monstruo\n"
"Por cada nivel superior al monstruo: Tasa de acierto del monstruo -0.5%\n"
"Por cada nivel inferior al monstruo: Tasa de acierto del monstruo +0.5%"

