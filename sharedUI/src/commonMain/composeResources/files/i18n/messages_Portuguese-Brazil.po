msgid "伐木"
msgstr "Madeireiro"

msgid ""
"主要产出：原木、水果\n"
"\n"
"用途：\n"
"- 原木 → 转化为炭（冶炼、烹饪所需）\n"
"- 原木 → 建造社区基础设施\n"
"- 水果 → 转化为肥料（农业所需）\n"
"\n"
"技能加成：每级 +0.25% 伐木效率（提供立即完成行动的概率）\n"
"核心工具：斧头（提高伐木速度）"
msgstr ""
"Produção principal: Toras, Frutas\n"
"\n"
"Uso:\n"
"- Toras → Convertidas em carvão (necessário para fundição e culinária)\n"
"- Toras → Construção de infraestrutura comunitária\n"
"- Frutas → Convertidas em fertilizante (necessário para agricultura)\n"
"\n"
"Bônus de habilidade: +0,25% de eficiãncia de corte por nível (oferece chance "
"de concluir a ação instantaneamente)\n"
"Ferramenta principal: Machado (aumenta a velocidade de corte)"

msgid "采矿"
msgstr "Mineração"

msgid ""
"主要产出：矿石、宝石\n"
"\n"
"用途：\n"
"- 矿石 → 冶炼成锭\n"
"- 宝石 → 冶炼成宝石精华\n"
"\n"
"技能加成：每级 +0.25% 采矿效率（提供立即完成行动的概率）\n"
"核心工具：镐子（提高采矿速度）"
msgstr ""
"Produção principal: Minérios, Gemas\n"
"\n"
"Uso:\n"
"- Minérios → Fundidos em barras\n"
"- Gemas → Fundidas em essãncia de gema\n"
"\n"
"Bônus de habilidade: +0,25% de eficiãncia de mineração por nível (oferece "
"chance de concluir a ação instantaneamente)\n"
"Ferramenta principal: Picareta (aumenta a velocidade de mineração)"

msgid "冶炼"
msgstr "Fundição"

msgid ""
"制作内容：\n"
"- 矿石 + 炭 → 锭\n"
"- 宝石 + 炭 → 宝石精华\n"
"\n"
"用途：\n"
"- 锭和宝石精华 → 锻造武器、工具、盔甲、饰品\n"
"- 锭和宝石精华 → 建造社区基础设施\n"
"\n"
"技能加成：每级 +0.25% 冶炼效率（提供立即完成行动的概率）\n"
"核心建筑：熔炉（提高冶炼速度）"
msgstr ""
"Produção:\n"
"- Minério + Carvão → Lingote\n"
"- Gema + Carvão → Essência de Gema\n"
"\n"
"Uso:\n"
"- Lingotes e Essência de Gema → Forjar armas, ferramentas, armaduras, "
"acessórios\n"
"- Lingotes e Essência de Gema → Construir infraestrutura comunitária\n"
"\n"
"Bônus de Habilidade: +0,25% de eficiência de fundição por nível (chance de "
"completar a ação instantaneamente)\n"
"Construção principal: Fornalha (aumenta a velocidade de fundição)"

msgid "锻造"
msgstr "Forjaria"

msgid ""
"制作内容：武器、工具、盔甲、饰品\n"
"所需材料：锭、宝石精华\n"
"技能加成：每级 +0.25% 锻造效率（提供立即完成行动的概率）\n"
"核心建筑：铁砧（提高锻造速度）"
msgstr ""
"Produção: armas, ferramentas, armaduras, acessórios\n"
"Materiais necessários: Lingotes, Essência de Gema\n"
"Bônus de Habilidade: +0,25% de eficiência de forjaria por nível (chance de "
"completar a ação instantaneamente)\n"
"Construção principal: Bigorna (aumenta a velocidade de forjaria)"

msgid "农业"
msgstr "Agricultura"

msgid ""
"主要产出：鲜花、蔬菜\n"
"\n"
"用途：\n"
"- 鲜花 → 炼金术制作药水\n"
"- 蔬菜 → 烹饪豪华料理（战斗治疗）\n"
"\n"
"所需材料：\n"
"- 种子（商店购买）\n"
"- 肥料（由水果转化）\n"
"\n"
"技能加成：每级 +0.25% 农业效率（提供立即完成行动的概率）\n"
"核心工具：铲子（提高农业速度）"
msgstr ""
"Produção principal: flores, vegetais\n"
"\n"
"Uso:\n"
"- Flores → alquimia para fazer poções\n"
"- Vegetais → cozinhar refeições luxuosas (cura em combate)\n"
"\n"
"Materiais necessários:\n"
"- Sementes (compradas na loja)\n"
"- Fertilizante (convertido de frutas)\n"
"\n"
"Bônus de Habilidade: +0,25% de eficiência de agricultura por nível (chance de "
"completar a ação instantaneamente)\n"
"Ferramenta principal: Pá (aumenta a velocidade de agricultura)"

msgid "炼金"
msgstr "Alquimia"

msgid ""
"制作内容：各类药水\n"
"\n"
"所需材料：\n"
"- 鲜花（农业）\n"
"- 骨头（战斗）\n"
"- 瓶子（商店）\n"
"\n"
"药水效果：提供多种增益效果，默认持续 180 秒\n"
"技能加成：每级 +0.25% 炼金效率（提供立即完成行动的概率）\n"
"核心建筑：炼金实验室（提高炼金速度）"
msgstr ""
"Produção: vários tipos de poções\n"
"\n"
"Materiais necessários:\n"
"- Flores (agricultura)\n"
"- Ossos (combate)\n"
"- Frascos (loja)\n"
"\n"
"Efeito das poções: oferece vários bônus, duração padrão de 180 "
"segundos\n"
"Bônus de Habilidade: +0,25% de eficiência de alquimia por nível (chance de "
"completar a ação instantaneamente)\n"
"Construção principal: Laboratório de Alquimia (aumenta a velocidade de "
"alquimia)"

msgid "钓鱼"
msgstr "Pesca"

msgid ""
"主要产出：鱼\n"
"用途：烹饪料理（战斗治疗）\n"
"技能加成：每级 +0.25% 钓鱼效率（提供立即完成行动的概率）\n"
"核心工具：鱼竿（提高钓鱼速度）"
msgstr ""
"Produção principal: peixes\n"
"Uso: cozinhar refeições (cura em combate)\n"
"Bônus de Habilidade: +0,25% de eficiência de pesca por nível (chance de "
"completar a ação instantaneamente)\n"
"Ferramenta principal: Vara de pescar (aumenta a velocidade de pesca)"

msgid "烹饪"
msgstr "Culinária"

msgid ""
"制作内容：各类料理\n"
"所需材料：食材（鱼和蔬菜）+ 炭\n"
"料理效果：战斗中生命值低于 33% 时自动使用，恢复生命值（冷却时间 15 秒）\n"
"技能加成：每级 +0.25% 烹饪效率（提供立即完成行动的概率）\n"
"核心建筑：烹饪锅（提高烹饪速度）"
msgstr ""
"Produção: vários tipos de pratos\n"
"Materiais necessários: ingredientes (peixes e vegetais) + carvão\n"
"Efeito dos pratos: usado automaticamente em combate quando a vida está abaixo "
"de 33%, restaura vida (tempo de recarga de 15 segundos)\n"
"Bônus de Habilidade: +0,25% de eficiência de culinária por nível (chance de "
"completar a ação instantaneamente)\n"
"Construção principal: Panela (aumenta a velocidade de culinária)"

msgid "狩猎"
msgstr "Caça"

msgid ""
"主要产出：皮革、墨水、羽毛\n"
"用途：制作地图（制图技能所需）\n"
"所需材料：蚯蚓（钓鱼获得）\n"
"技能加成：每级 +0.25% 狩猎效率（提供立即完成行动的概率）\n"
"核心工具：陷阱（提高狩猎速度）"
msgstr ""
"Produção principal: couro, tinta, penas\n"
