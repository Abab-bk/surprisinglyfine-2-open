msgid "每成功闪避一次攻击，下一次攻击必定暴击。"
msgstr "攻撃を回避するたびに、次の攻撃が必ずクリティカルヒットになる。"

msgid "百折不挠的真诚"
msgstr "不屈の誠実"

msgid "攻击时有 3% 的概率触发两次伤害。"
msgstr "攻撃時に3%の確率で2倍のダメージを与える。"

msgid "直言不讳的勇敢"
msgstr "率直な勇気"

msgid "每场战斗随机激活 1 个效果：+50% 伤害 / +30% 防御 / 双倍经验"
msgstr "戦闘ごとにランダムに1つの効果を発動：ダメージ+50%、防御+30%、経験値2倍。"

msgid "空想家"
msgstr "空想家"

msgid "击杀一名敌人后，掉落稀有物品的概率 +1%，可叠加，但是生命值低于 50% 时失效。"
msgstr "敵を倒した後、レアアイテムのドロップ率が1%上昇する（スタック可能、ただしHPが50%未満になると無効）。"

msgid "令人震惊的"
msgstr "驚くべき"

msgid "生命低于 20% 时，自动触发“再生”，每秒回复 5% 生命（持续 10 秒，CD 2 分钟）。"
msgstr "HPが20%未満になると自動的に「再生」が発動し、10秒間毎秒5%のHPを回復する（クールダウン2分）。"

msgid "恐慌的"
msgstr "パニック状態の"

msgid "命中时，5% 几率使敌人无法行动 5 秒。不可重复触发。"
msgstr "命中時に5%の確率で敵を5秒間行動不能にする（重複発動不可）。"

msgid "无法忍受的"
msgstr "耐え難い"

msgid "承受切割伤害时，10% 几率反弹 50% 伤害给攻击者。"
msgstr "切断ダメージを受けた時、10%の確率でダメージの50%を攻撃者に跳ね返す。"

msgid "邪恶的"
msgstr "邪悪な"

msgid "钓鱼速度提升 15%，但 10% 概率什么也不获得。"
msgstr "釣り速度が15%上昇するが、10%の確率で何も獲得できない。"

msgid "难以置信的"
msgstr "信じられないほどの"

msgid "砍树时，5% 的概率获得 1 木炭。"
msgstr "木を伐採する時、5%の確率で木炭を1個獲得する。"

msgid "搞点货"
msgstr "物資調達"

msgid "获得的战斗经验降低 30%，但将这部分的 50% 均分给所有非战斗技能。"
msgstr "戦闘経験値が30%減少するが、その減少分の50%が非戦闘スキルに均等分配される。"

msgid "空间管理"
msgstr "空間管理"

msgid "背包格子每空出一格，获得 0.2% 的全局伤害加成；每占用一格，获得 0.2% 的全局减伤。"
msgstr "バックパックの空き枠1つにつき全ダメージ+0.2%、アイテムが入っている枠1つにつき全ダメージ軽減+0.2%。"

msgid "麻烦的"
msgstr "厄介な"

msgid "战斗奖励不会再掉落金币，会选择其他掉落物作为替代。"
msgstr "戦闘報酬でゴールドがドロップしなくなり、代わりに他のアイテムがドロップするようになる。"

msgid "一心二用的"
msgstr "二心併用の"

msgid "佩戴并战斗时，考古的速度提升 10%。"
msgstr "装備して戦闘すると、考古学の速度が10%上昇する。"

msgid "底子很好的"
msgstr "下地が良い"

msgid "攻击间隔每有 2s，最终伤害 +10%。"
msgstr "攻撃間隔が2秒あるごとに、最終ダメージが+10%される。"

msgid "主角般的"
msgstr "主人公のような"

msgid "敌人对你的命中率提升 20%，但作为回报，敌人掉落稀有物品的概率提升 1.5 倍。"
msgstr "敵からの命中率が20%上昇するが、代わりに敵がレアアイテムをドロップする確率が1.5倍になる。"

msgid "形容词的"
msgstr "形容詞的な"

msgid "你的命中率降低 20%，但你的所有技能的产出倍率增加 10%。"
msgstr "命中率が20%低下するが、全スキルの産出倍率が10%増加する。"

msgid "哈哈哈"
msgstr "ハハハ"

msgid "训练技能时有 10% 概率播放哈哈的笑声。"
msgstr "スキルを訓練する時、10%の確率で笑い声が再生される。"

msgid "Shift+Tab"
msgstr "Shift+Tab"

msgid "佩戴时，每次打开 Steam 覆盖层 +1 金币。"
msgstr "装備中、Steamオーバーレイを開くたびに+1ゴールドを得る。"

